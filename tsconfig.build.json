{
  // Publish build: emits JS + declarations to dist/. The base config stays
  // noEmit and covers the tests too, so it can keep serving `bun run typecheck`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["index.ts", "src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
