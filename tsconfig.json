{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // An optional property means "may be absent", not "may be present and
    // undefined" — so a maybe-undefined value can't be forwarded into one by
    // accident. Option bags that genuinely accept both spell it `?: T |
    // undefined`.
    "exactOptionalPropertyTypes": true,
    // Type-only imports are written `import type`, so what tsc emits is
    // exactly the imports that run.
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "src/**/*"]
}
