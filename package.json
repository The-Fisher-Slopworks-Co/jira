{
  "name": "@slopworks/jira",
  "version": "0.1.0",
  "description": "Cookie-auth Jira Server / Data Center REST client (no API token).",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Fisher-Slopworks-Co/jira.git"
  },
  "bugs": {
    "url": "https://github.com/The-Fisher-Slopworks-Co/jira/issues"
  },
  "homepage": "https://github.com/The-Fisher-Slopworks-Co/jira#readme",
  "keywords": [
    "jira",
    "jira-server",
    "jira-data-center",
    "rest-client",
    "cookie-auth",
    "jsessionid"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSES",
    "REUSE.toml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
